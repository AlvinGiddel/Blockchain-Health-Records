# ==============================================================================
# Environment Configuration for Local Docker Development (.env.docker)
# Copy this file to .env.docker before running: docker compose up
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String for Local Docker (Service name is 'postgres')
# Uses plain unencrypted connection with sslmode=disable
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/healthchain?sslmode=disable
DB_SSL=false


# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Secret Key for JWT Token Signing
JWT_SECRET=dev_jwt_secret_key_blockchain_health_local_docker_12345

# AES Field-Level Encryption Key (64-character hex string representing 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gmail API OAuth2 Email Settings (Mocked for local development)
GMAIL_USER=dev@bhc.local
GMAIL_CLIENT_ID=mock_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=mock_client_secret
GMAIL_REFRESH_TOKEN=mock_refresh_token

# Optional Fallback SMTP Email
EMAIL_USER=dev@bhc.local
EMAIL_PASS=mock_app_password

# Keep-Alive Self-Ping (Disabled for local dev)
ENABLE_KEEP_ALIVE=false
KEEP_ALIVE_INTERVAL_MINUTES=14

# Blockchain Autonomous Miner Worker Settings
MEMPOOL_THRESHOLD=10
MINE_INTERVAL_MS=60000

# Super Administrator Credentials (Matching 00_init_base_schema.sql seed)
SUPER_ADMIN_EMAIL=superadmin@bhc.local
SUPER_ADMIN_PASSWORD=SuperAdmin#Secure2026!

# Remote Licensing Kill-Switch Settings
CLIENT_ID=bhc-client-001
LICENSE_SERVER_URL=mock
LICENSE_CHECK_INTERVAL_MS=21600000
MOCK_LICENSE_STATUS=active

# Paystack Payment Gateway Settings (Test Sandbox Keys)
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key_here
