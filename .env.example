# Backend Environment Variables

# Express Server Port
PORT=5000

# Supabase (PostgreSQL) Connection String
DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Allowed Frontend URL for CORS (e.g. your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# Secret Key for JWT token signing
JWT_SECRET=your_jwt_secret_key_here

# AES Field-Level Encryption Key (32-byte hex string)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Gmail API OAuth2 Email Settings (Vercel Serverless Production)
# Required for sending password reset emails via Gmail API OAuth2.
# NOTE: In production on Vercel, these must be configured under:
# Vercel Dashboard -> Project Settings -> Environment Variables.
GMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=your_google_oauth2_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth2_client_secret
GMAIL_REFRESH_TOKEN=your_oauth2_playground_refresh_token

# Fallback SMTP Email Settings (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Render Keep-Alive Settings
# Set ENABLE_KEEP_ALIVE=false (default) so Render spins down when inactive to preserve free compute hours.
# Set ENABLE_KEEP_ALIVE=true only if you want the service to stay awake 24/7.
ENABLE_KEEP_ALIVE=false
KEEP_ALIVE_INTERVAL_MINUTES=14

# Blockchain Auto-Miner Settings
# Number of pending records in the mempool required to trigger automatic block mining
MEMPOOL_THRESHOLD=10
# Interval (in ms) to check for and mine any pending straggler records (fallback timer, default: 60000ms / 1 min)
MINE_INTERVAL_MS=60000

# Super Administrator Credentials (One-time manual seed via node backend/scripts/seedSuperAdmin.js)
SUPER_ADMIN_EMAIL="superadmin@bhc.local"
SUPER_ADMIN_PASSWORD="your_super_admin_password_here"

# Remote Licensing Kill-Switch Settings
CLIENT_ID=bhc-client-001
# Set to 'mock' for local offline testing or full Supabase Edge Function URL in production
LICENSE_SERVER_URL=mock
# Recurring check interval in ms (default: 21600000 = 6 hours)
LICENSE_CHECK_INTERVAL_MS=21600000
# Mock status when LICENSE_SERVER_URL=mock ('active' or 'disabled')
MOCK_LICENSE_STATUS=active


